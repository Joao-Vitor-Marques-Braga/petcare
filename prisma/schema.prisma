generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PetSize {
  PEQUENO
  MEDIO
  GRANDE
}

enum AppointmentService {
  BANHO
  TOSA_HIGIENICA
  TOSA_COMPLETA
  BANHO_E_TOSA
}

enum AppointmentStatus {
  PENDENTE
  MENSAGEM_ENVIADA
  CONFIRMADO
  CANCELADO_REAGENDAR
}

model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  phone     String?
  plan      String   @default("PRO")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("PETSHOP_ADMIN") // SUPER_ADMIN | PETSHOP_ADMIN
  companyId    String   @default("default")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@map("users")
}

model Customer {
  id           String        @id @default(uuid())
  companyId    String        @default("default")
  name         String
  phone        String        // Normalizado com DDI e DDD (ex: 5511999998888)
  email        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  pets         Pet[]
  appointments Appointment[]

  @@index([companyId])
  @@index([phone])
  @@map("customers")
}

model Pet {
  id           String        @id @default(uuid())
  name         String
  breed        String        // Raça
  size         PetSize       // Porte: Pequeno, Médio, Grande
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  appointments Appointment[]

  @@map("pets")
}

model Appointment {
  id               String             @id @default(uuid())
  companyId        String             @default("default")
  scheduledAt      DateTime           // Data e Hora do agendamento
  service          String             @default("BANHO")
  serviceName      String?            // Nome amigável do serviço
  servicePrice     Float?             // Valor cobrado pelo serviço (R$)
  status           AppointmentStatus  @default(PENDENTE)
  notes            String?
  customerId       String
  customer         Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  petId            String
  pet              Pet                @relation(fields: [petId], references: [id], onDelete: Cascade)
  lastReminderSent DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  logs             NotificationLog[]

  @@index([companyId])
  @@index([scheduledAt])
  @@index([status])
  @@map("appointments")
}

model ServiceCatalog {
  id              String   @id @default(uuid())
  companyId       String   @default("default")
  code            String
  name            String
  description     String?
  price           Float    @default(0)
  durationMinutes Int      @default(60)
  category        String   @default("ESTETICA") // HIGIENE, ESTETICA, COMBO, SAUDE
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("service_catalog")
}

model NotificationLog {
  id            String       @id @default(uuid())
  appointmentId String
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel       String       @default("WHATSAPP")
  direction     String       // "OUTBOUND" (lembrete enviado) | "INBOUND" (resposta recebida)
  payload       String?      // Conteúdo raw / JSON resumido
  status        String       // "SUCCESS" | "FAILED" | "RECEIVED"
  createdAt     DateTime     @default(now())

  @@map("notification_logs")
}

model WhatsAppConfig {
  id           String   @id @default("default")
  apiUrl       String   @default("http://localhost:8080")
  apiKey       String   @default("")
  instanceName String   @default("petshop_bot")
  senderPhone  String?  // Número do WhatsApp que envia (ex: 5511999998888)
  isMockMode   Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@map("whatsapp_configs")
}
