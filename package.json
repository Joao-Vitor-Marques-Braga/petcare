{
  "name": "petshop-anti-furo-backend",
  "version": "1.0.0",
  "description": "Backend API para Gestão de Agendamentos e Anti-Furo via WhatsApp para Pet Shops",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/presentation/server.ts",
    "build": "tsc",
    "start": "node dist/presentation/server.js",
    "setup:local": "prisma db push --schema=prisma/schema.sqlite.prisma && tsx prisma/seed.ts",
    "setup:postgres": "prisma db push --schema=prisma/schema.prisma && tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "prisma": "^5.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
